# Todo el texto se guarda con finales de línea LF en el repositorio,
# sin importar con qué sistema se haya escrito. Sin esto, los archivos
# creados en Windows quedan permanentemente marcados como modificados.
* text=auto eol=lf

# Binarios: git no debe tocarlos.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
