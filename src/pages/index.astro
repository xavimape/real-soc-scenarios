---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const scenarios = (await getCollection('scenarios')).sort(
  (a, b) => a.data.caseNumber - b.data.caseNumber
);

const sevVar = (severity: string) =>
  `var(--sev-${severity.toLowerCase()}, var(--text-muted))`;
---

<BaseLayout
  title="Real SOC Scenarios"
  description="Casos reales de investigación SOC, paso a paso."
  descriptionEn="Real SOC investigation cases, step by step."
>
  <h1>Real SOC Scenarios</h1>
  <p class="sub">
    <span data-lang="es">{scenarios.length} casos de investigación SOC</span>
    <span data-lang="en">{scenarios.length} SOC investigation cases</span>
  </p>

  <ul class="list">
    {
      scenarios.map((entry) => (
        <li class="card">
          <a class="card-link" href={`/scenarios/${entry.id}/`}>
            #{entry.data.caseNumber} —{' '}
            <span data-lang="es">{entry.data.title}</span>
            <span data-lang="en">{entry.data.titleEn ?? entry.data.title}</span>
          </a>
          <p class="desc">
            <span data-lang="es">{entry.data.description}</span>
            <span data-lang="en">{entry.data.descriptionEn ?? entry.data.description}</span>
          </p>
          <div class="meta">
            <span class="badge" style={`background:${sevVar(entry.data.severity)}`}>
              {entry.data.severity}
            </span>
            <span class="tag">{entry.data.difficulty}</span>
            <span class="tag">{entry.data.caseId}</span>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.15rem;
  }

  .sub {
    color: var(--text-muted);
    margin-top: 0;
    font-size: 0.9rem;
  }

  .list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 0.9rem 1.1rem;
    margin-bottom: 0.75rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .card:hover {
    transform: translateX(4px);
    border-color: var(--accent);
  }

  .card-link {
    font-weight: 600;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0.35rem 0 0;
  }

  .meta {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.55rem;
  }

  .badge {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--bg);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .tag {
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
