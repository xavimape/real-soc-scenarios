---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { mdxComponents } from '@/components/mdx/marks.jsx';

// getStaticPaths corre en un scope aislado: NO ve las variables del frontmatter.
// Por eso la colección se carga acá adentro (esto causaba "scenarios is not defined").
export async function getStaticPaths() {
  const scenarios = await getCollection('scenarios');

  return scenarios.map((entry) => ({
    // En Astro 7 el identificador es entry.id (antes entry.slug).
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'scenarios'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const sevVar = `var(--sev-${entry.data.severity.toLowerCase()}, var(--text-muted))`;
---

<BaseLayout
  title={entry.data.title}
  titleEn={entry.data.titleEn}
  description={entry.data.description}
  descriptionEn={entry.data.descriptionEn}
  showBack
>
  <article>
    <div class="meta">
      <span class="badge" style={`background:${sevVar}`}>{entry.data.severity}</span>
      <span class="tag">{entry.data.difficulty}</span>
      <span class="tag">{entry.data.caseId}</span>
      {entry.data.author && <span class="tag">{entry.data.author}</span>}
    </div>

    <h1>
      <span data-lang="es">{entry.data.title}</span>
      <span data-lang="en">{entry.data.titleEn ?? entry.data.title}</span>
    </h1>
    <p class="lead">
      <span data-lang="es">{entry.data.description}</span>
      <span data-lang="en">{entry.data.descriptionEn ?? entry.data.description}</span>
    </p>
    <hr />

    <Content components={mdxComponents} />
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .badge {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--bg);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .tag {
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  h1 {
    margin: 0 0 0.3rem;
  }

  .lead {
    color: var(--text-muted);
    margin-top: 0;
  }

  article :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
